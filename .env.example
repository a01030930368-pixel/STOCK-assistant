# 복사해서 .env로 저장한 뒤 값을 채우세요. .env는 git에 올라가지 않습니다.

# DB
POSTGRES_USER=stock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stock

# 웹 접속 비밀번호 (휴대폰에서 외부 접속할 때 필요)
APP_PASSWORD=change-me

# 키움 REST API (openapi.kiwoom.com에서 발급). 주문 권한이 있는 키이므로 절대 공유하지 마세요.
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# true면 모의투자 서버(mockapi.kiwoom.com) 사용
KIWOOM_MOCK=true

# 텔레그램 봇 (@BotFather에서 발급) 과 내 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 장중 잔고·알림 확인 간격(초)
POLL_SECONDS=60

# 매크로 지표 자동 수집(선택). 둘 다 무료 가입 후 발급됩니다. 비워 두면 매크로 메모는 직접 입력합니다.
# 한국은행 ECOS: https://ecos.bok.or.kr/api/ -> 인증키 신청
ECOS_API_KEY=
# 미국 FRED: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# 종목 뉴스·실적·재무(선택). 모두 무료입니다. 비워 둔 항목은 건너뜁니다.
# OpenDART(국내 실적 공시·재무제표): https://opendart.fss.or.kr -> 인증키 신청
DART_API_KEY=
# 국내 뉴스는 키 없이 구글 뉴스에서 가져옵니다. 네이버 뉴스를 쓰고 싶을 때만 아래를 채우세요.
# 네이버 클라우드 콘솔 > NAVER API HUB > 뉴스 검색 API 애플리케이션 > 인증 정보 (개발자센터 키는 안 됩니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Finnhub(미국 뉴스·분기 EPS): https://finnhub.io/register
FINNHUB_API_KEY=
# SEC EDGAR(미국 재무제표)는 키가 없고, 요청에 연락처 이메일을 붙여야 합니다.
SEC_CONTACT_EMAIL=

# AI 한마디(선택, 유료). 보유 종목마다 하루 한 번 Claude가 짧은 점검 메모를 씁니다.
# https://console.anthropic.com -> API Keys 에서 만들고, Billing에서 크레딧을 충전해야 동작합니다.
# 비워 두면 AI 한마디를 건너뜁니다. AI_MODEL을 비우면 claude-haiku-5-5(가장 저렴)를 씁니다.
ANTHROPIC_API_KEY=
AI_MODEL=
